# Optional local overrides. Copy to .env (git-ignored):  cp .env.example .env
#
# `docker compose up` needs none of this: compose.yaml has development defaults.
# `make` also loads this file, so keep plain KEY=value lines (no quotes, no spaces,
# no `$` or `#` in values). Development-only values; never put real credentials here.

# PostgreSQL (docker compose)
POSTGRES_USER=campaign
POSTGRES_PASSWORD=campaign
POSTGRES_DB=campaign

# Host ports published by docker compose
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=3000

# API running on the host (`make db && make run`). The api container gets its own
# values from compose.yaml.
DATABASE_URL=postgres://campaign:campaign@localhost:5432/campaign?sslmode=disable
HTTP_ADDR=:8080
LOG_LEVEL=debug
LOG_FORMAT=text
