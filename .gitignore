# =============================================================================
# Secrets & environment files — NEVER commit these
# =============================================================================
# Env files (covers Vite/Vue modes too: .env.local, .env.production, ...)
.env
.env.*
*.env
.envrc

# Keep the template tracked (must come AFTER the .env.* rule)
!.env.example

# Private keys & keystores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
id_rsa*
id_ecdsa*
id_ed25519*
.htpasswd
.netrc

# Cloud / service credentials
credentials.json
*credentials*.json
client_secret*.json
service-account*.json
*.serviceaccount.json
.aws/
.gcloud/

# Generic secret stores (root-anchored so Go packages named "secrets" stay tracked)
/secrets/
.secrets/
*.secret
*.secrets

# =============================================================================
# Go
# =============================================================================
# Compiled binaries & shared libraries
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/

# Test binaries & coverage
*.test
*.out
*.coverprofile
coverage.html
profile.cov

# Debugger binaries (Delve / VS Code Go)
__debug_bin*

# Local workspace files
go.work
go.work.sum

# Live-reload (air) artifacts
tmp/
build-errors.log

# Dependency vendoring — uncomment if you do NOT commit vendor/
# vendor/

# =============================================================================
# Vue / Node / Vite
# =============================================================================
node_modules/
dist/
dist-ssr/
.vite/
.nuxt/
.output/
*.local
*.timestamp-*-*.mjs
__screenshots__/

# Caches
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Patterns containing a "/" only match next to this file unless prefixed with **/,
# so the ones below use **/ to also cover frontend/.

# Yarn Berry (keep the files Yarn expects to be committed)
.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/sdks
!**/.yarn/versions

# Test & coverage output
coverage/
.nyc_output/
**/cypress/videos/
**/cypress/screenshots/
test-results/
playwright-report/
blob-report/
**/playwright/.cache/

# =============================================================================
# Logs
# =============================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =============================================================================
# IDEs & editors
# =============================================================================
# VS Code — keep shared extension recommendations only (at any depth)
**/.vscode/*
!**/.vscode/extensions.json
.history/

# JetBrains (GoLand, WebStorm, IntelliJ)
.idea/
*.iml
*.ipr
*.iws

# Others
.fleet/
.vs/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Claude Code personal settings
.claude/settings.local.json

# =============================================================================
# OS files
# =============================================================================
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
